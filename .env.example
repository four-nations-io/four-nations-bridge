# four-nations-bridge — environment template
#
# Rebuilt 2026-08-13 (Phase G, G.0f) from the verified read surface: every
# `process.env` read in src/ plus every `${VAR}` in this project's compose files.
# Prior template: .env.example.archive.
#
# ⚠️ This daemon runs on the CREATOR's own machine, not on the VPS. Values here are
# about THEIR hardware and THEIR folders. Most installs only need the first section
# — everything below it has a working default.
#
# For an OPTIONAL var, DELETE THE LINE rather than leaving it blank — `FOO=` reads
# as the empty string, not undefined.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — connection + identity
# ─────────────────────────────────────────────────────────────────────────────

# The public gateway. This must be the public hostname, NOT a LAN IP — a LAN
# address only ever works on the machine that happens to share that network.
CONTENT_BRIDGE_SAAS_URL=wss://bridge.four-nations.com

# One-time code from the app (Settings → Content Bridge) to pair this device.
CONTENT_BRIDGE_PAIRING_CODE=

# How this device appears in the app's device list.
CONTENT_BRIDGE_DEVICE_LABEL=
CONTENT_BRIDGE_DEVICE_PLATFORM=

# Folder on the host holding the content to share. Mounted read-only.
CONTENT_BRIDGE_HOST_CONTENT_PATH=

# ─────────────────────────────────────────────────────────────────────────────
# PATHS
# ─────────────────────────────────────────────────────────────────────────────

CONTENT_BRIDGE_STATE_DIR=/state
CONTENT_BRIDGE_CACHE_ROOT=/cache
CONTENT_BRIDGE_CONTAINER_MOUNT_PATH=/sources/local

# Managed mode — the bridge creates and owns a project folder structure.
CONTENT_BRIDGE_MANAGED_ENABLED=false
# CONTENT_BRIDGE_MANAGED_HOST_PATH=
# CONTENT_BRIDGE_MANAGED_ROOT=
# CONTENT_BRIDGE_DEFAULT_TEMPLATE_PATH=

# ─────────────────────────────────────────────────────────────────────────────
# SETUP UI — the local wizard, reachable only on the host's own network
# ─────────────────────────────────────────────────────────────────────────────

CONTENT_BRIDGE_SETUP_UI_PORT=8099
CONTENT_BRIDGE_SETUP_UI_BIND=127.0.0.1
# CONTENT_BRIDGE_SETUP_UI_HOST=
# CONTENT_BRIDGE_SETUP_UI_LAN=false
# CONTENT_BRIDGE_SETUP_TOKEN=
# CONTENT_BRIDGE_FORCE_WIZARD=false
# CONTENT_BRIDGE_AUTO_PAIR=true

# ─────────────────────────────────────────────────────────────────────────────
# CACHE + REINDEX
# ─────────────────────────────────────────────────────────────────────────────

CONTENT_BRIDGE_CACHE_CAP_BYTES=53687091200
CONTENT_BRIDGE_CACHE_SWEEP_MINUTES=60
CONTENT_BRIDGE_REINDEX_SCAN_SECONDS=900

# ─────────────────────────────────────────────────────────────────────────────
# THUMBNAILS — tuned low on purpose so a creator's machine stays responsive
# ─────────────────────────────────────────────────────────────────────────────

CONTENT_BRIDGE_THUMB_CONCURRENCY=1
CONTENT_BRIDGE_THUMB_CPU_NICE=10
CONTENT_BRIDGE_THUMB_DELAY_MS=250
CONTENT_BRIDGE_THUMB_JPEG_QUALITY=80
CONTENT_BRIDGE_THUMB_MAX_DIM_PX=640
CONTENT_BRIDGE_THUMB_POSITIONS=10%,30%,50%
CONTENT_BRIDGE_THUMB_OUTPUT_MODE=cache
CONTENT_BRIDGE_THUMB_CACHE_TTL_DAYS=30
# CONTENT_BRIDGE_THUMB_WRITABLE_ROOT=
# CONTENT_BRIDGE_THUMB_SUBPATH_WITHIN_PROJECT=

# ─────────────────────────────────────────────────────────────────────────────
# TRANSCODE / PROXY
# ─────────────────────────────────────────────────────────────────────────────

CONTENT_BRIDGE_PROXY_QUALITY_CRF=28
CONTENT_BRIDGE_PROXY_THREADS=1
CONTENT_BRIDGE_PROXY_SKIP_BELOW_BYTES=10485760
CONTENT_BRIDGE_PROXY_CACHE_TTL_MINUTES=1440
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ─────────────────────────────────────────────────────────────────────────────
# CONTAINER
# ─────────────────────────────────────────────────────────────────────────────

CONTENT_BRIDGE_IMAGE_TAG=1.3.3
# CONTENT_BRIDGE_RUN_AS_USER=

# ─────────────────────────────────────────────────────────────────────────────
# NOTE: .env.example.simple is a separate, deliberately-minimal template for the
# one-file zero-paste install (doc 120). It was NOT rebuilt here — it is a
# user-facing install artifact with its own contract, not a full config surface.
# ─────────────────────────────────────────────────────────────────────────────
