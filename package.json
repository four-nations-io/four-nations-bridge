{
  "name": "four-nations-bridge",
  "version": "1.3.0",
  "description": "Cross-platform content bridge for four-nations-web SaaS (Phase F per planning doc 46). Runs as a Docker container on the creator's NAS / Mac / PC; pushes file metadata + encrypted thumbs + encrypted byte-range previews to the SaaS over outbound WSS.",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-public-assets.mjs",
    "start": "node dist/main.js",
    "test": "node --test test/",
    "test-notif": "node dist/cli/test-notif.js",
    "dev": "npm run build && node dist/main.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "fluent-ffmpeg": "^2.1.3",
    "sharp": "^0.33.5",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=24"
  }
}
